# ── Vercel (required for API functions & KV) ─────────────────────────
# Used by api/get-blogs.js, api/sync-blog.js, api/contact.js and sync-cli.js
KV_REST_API_URL=https://your-kv-instance.rest.vercel-storage.com
KV_REST_API_TOKEN=your-kv-token

# ── Email delivery for the contact form (choose ONE provider) ────────
# Option A — Resend (recommended): https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_key
RESEND_FROM=Imran Khan Lincoln <onboarding@resend.dev>

# Option B — SMTP (Gmail, Zoho, Mailgun, etc.)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM=Website Contact <you@example.com>

# ── Site configuration ────────────────────────────────────────────────
# Where contact-form messages are delivered (info.md has no email yet)
CONTACT_TO_EMAIL=contact@imrankhanlincoln.com
# Canonical domain used in sitemap.xml, robots.txt, and SEO meta tags
SITE_URL=https://imrankhanblog.netlify.app
